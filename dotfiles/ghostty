app-notifications = no-clipboard-copy

background-blur = 10
background-opacity = 0.95

clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

confirm-close-surface = true

copy-on-select = clipboard

cursor-style = bar
cursor-style-blink = false

custom-shader = ~/.config/ghostty/bloom.glsl

font-family = JetBrains Mono Nerd Font
font-feature  = -dlig
font-feature = -calt
font-feature = -liga
font-size = 10

gtk-tabs-location = bottom
gtk-wide-tabs = false

keybind = ctrl+shift+slash=start_search

minimum-contrast = 1.1

mouse-hide-while-typing = true

quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 15s

scrollback-limit = 10000000

shell-integration-features = no-cursor

theme = Rose Pine

window-decoration = false
window-padding-balance = true
window-padding-x = 1
window-padding-y = 1
window-save-state = always
window-theme = ghostty

# Shift+Enter and Ctrl+Enter, spelled out for tmux.
#
# Ghostty reports modified keys through the kitty keyboard protocol, and tmux
# asks for them the older xterm way (modifyOtherKeys), which Ghostty does not
# implement. Neither side is wrong; they simply never agree, so tmux receives
# a plain Enter and every program inside it sees the same. Sending the escape
# sequence directly sidesteps the negotiation: tmux understands CSI-u input and
# passes it along unchanged.
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u
