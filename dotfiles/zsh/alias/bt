# Power on Bluetooth, connect the Blue Matrix headphones, and make them the
# default audio out/in. Drop the alias first so re-sourcing doesn't expand it.
unalias bt 2>/dev/null

# The sequence is _audio_bt_connect, shared with `jbl` — see dotfiles/zsh/
# alias/_audio. What is actually specific to these headphones is the address,
# the name, and where to look when they don't answer.
bt() {
  _audio_bt_connect BC:87:FA:BC:1A:4B "Blue Matrix" \
    "powered on and out of its case?"
}
