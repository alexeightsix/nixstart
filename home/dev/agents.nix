# Coding agents. Pi's configuration is handled separately, in pi.nix.
{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:
let
  cfg = config.nixstart.home;

  # `agent-apply` on PATH, execing the script in the working checkout.
  #
  # A thin wrapper rather than the script inlined into the store, and
  # deliberately: the point of this one is that an agent can edit the
  # configuration and then apply it, and a store copy could only ever apply
  # the version of itself that was built — so fixing agent-apply would
  # require an agent-apply that already worked. Reading it from the checkout
  # at run time breaks that circle, and matches what `checkout` is for
  # everywhere else in this repository.
  #
  # tmux is named here rather than assumed: the script is started by an agent
  # whose environment is whatever spawned it, and the one thing it cannot do
  # without is the session it runs the rebuild in.
  agentApply = pkgs.writeShellApplication {
    name = "agent-apply";
    runtimeInputs = [
      pkgs.tmux
      pkgs.coreutils
    ];
    text = ''
      exec ${cfg.checkout}/scripts/apply/agent-apply.sh "$@"
    '';
  };

  # opencode from its own flake (see flake.nix), with one correction.
  #
  # Upstream's nix/hashes.json is regenerated by CI after a release rather
  # than as part of it, so a freshly tagged version can ship the previous
  # release's node_modules hash and fail as a fixed-output mismatch. The
  # table below overrides it for exactly the versions that need it, keyed on
  # the version so a `bump-opencode` to a fixed release falls back to
  # upstream's own hash without anyone remembering to delete the entry.
  # When a bump fails this way, the "got:" hash from the error goes here.
  opencodeUpstream = inputs.opencode.packages.${pkgs.stdenv.hostPlatform.system};
  opencodeNodeModulesHash = {
    "2.2.5" = "sha256-+GgLX4lq8fPOJVoDGp220uiCTLB0ZwrBkcNo36q9MZU=";
  };
  opencodeVersion = builtins.head (lib.splitString "+" opencodeUpstream.opencode.version);
  opencodeHashed =
    if opencodeNodeModulesHash ? ${opencodeVersion} then
      opencodeUpstream.opencode.override {
        node_modules = opencodeUpstream.node_modules_updater.override {
          hash = opencodeNodeModulesHash.${opencodeVersion};
        };
      }
    else
      opencodeUpstream.opencode;

  # Upstream's nix/opencode.nix builds the CLI as channel "prod", which
  # registers its background service as service-prod.json. The desktop app
  # only looks for service.json — what the released "latest" channel writes —
  # so it never finds the service and sits on its splash screen. Both
  # channels use the same opencode.db, so sessions are unaffected.
  opencode = opencodeHashed.overrideAttrs (old: {
    env = old.env // {
      OPENCODE_CHANNEL = "latest";
    };
  });

  # The desktop app (what opencode.ai offers as an RPM/deb) from the same
  # flake, built on the corrected CLI above rather than upstream's.
  #
  # Upstream's nix/desktop.nix stages the CLI under $OPENCODE_CLI_DIST, but
  # as of 2.2.5 packages/desktop/script/build.ts ignores that variable and
  # only looks in ../cli/dist, so a prod build fails with "build it first".
  # The patch makes build.ts read the variable; --replace-quiet lets it go
  # quietly inert once upstream fixes this.
  opencodeDesktop =
    (opencodeUpstream.opencode-desktop.override { inherit opencode; }).overrideAttrs
      (old: {
        postPatch = (old.postPatch or "") + ''
          substituteInPlace packages/desktop/script/build.ts \
            --replace-quiet 'path.resolve(dir, "../cli/dist")' \
                            'process.env.OPENCODE_CLI_DIST ?? path.resolve(dir, "../cli/dist")'
        '';
      });
in
{
  config = lib.mkIf cfg.agents {
    home.packages = [
      pkgs.claude-code
      pkgs.codex
      opencode
      opencodeDesktop
      pkgs.grok-cli

      # herdr, the agent multiplexer: the TUI from nixpkgs, and the desktop
      # app (with its herdr-core server) from packages/herdr-app.
      pkgs.herdr
      pkgs.herdr-app

      # Applying a nix change is part of an agent's work here, not something
      # handed back to be run by hand. See scripts/apply/agent-apply.sh for what it
      # does about the two things that otherwise stop it — the terminal dying
      # mid-rebuild, and a sudo prompt nothing can answer.
      agentApply
    ];

    # rose-pine is one of herdr's built-in themes, so naming it is enough.
    # The file becomes a read-only store symlink: herdr can no longer write
    # it (e.g. `herdr config reset-keys`), so change settings here instead.
    #
    # Keys follow the tmux/Ghostty set in home/desktop/apps/ghostty.nix. herdr's
    # prefix is already ctrl+b, and c, x, z, h/j/k/l are its defaults, so
    # only the differences are listed; herdr's own keys stay alongside.
    # n is a new workspace here as in tmux.conf, which moves next tab to `.`.
    xdg.configFile."herdr/config.toml".text = ''
      [theme]
      name = "rose-pine"

      [keys]
      split_vertical = ["prefix+v", "prefix+percent"]
      split_horizontal = ["prefix+minus", "prefix+double_quote"]
      rename_tab = ["prefix+shift+t", "prefix+r"]
      new_workspace = ["prefix+shift+n", "prefix+n"]
      next_tab = "prefix+period"
      resize_mode = ["prefix+ctrl+left", "prefix+ctrl+right", "prefix+ctrl+up", "prefix+ctrl+down"]
      focus_pane_left = ["prefix+h", "ctrl+h"]
      focus_pane_down = ["prefix+j", "ctrl+j"]
      focus_pane_up = ["prefix+k", "ctrl+k"]
      focus_pane_right = ["prefix+l", "ctrl+l"]
      move_tab_previous = "ctrl+shift+left"
      move_tab_next = "ctrl+shift+right"
    '';
  };
}
