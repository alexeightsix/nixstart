+// parseMonitors reads WALLPAPER_MONITORS — a comma-separated list of X
+// geometries, "1920x1080+0+0,1680x1050+120+1080" — as the rectangles the
+// screens of a multi-head layout occupy on the image. Unset or empty gives a
+// single rectangle covering the whole image, which is the single-screen case
+// and the behaviour before this existed.
+func parseMonitors(bounds image.Rectangle) ([]image.Rectangle, error) {
+	spec := os.Getenv("WALLPAPER_MONITORS")
+	if spec == "" {
+		return []image.Rectangle{bounds}, nil
+	}
+
+	var rects []image.Rectangle
+	for _, field := range strings.Split(spec, ",") {
+		field = strings.TrimSpace(field)
+		if field == "" {
+			continue
+		}
+
+		var w, h, x, y int
+		if _, err := fmt.Sscanf(field, "%dx%d+%d+%d", &w, &h, &x, &y); err != nil {
+			return nil, fmt.Errorf("cannot parse monitor geometry %q: %v", field, err)
+		}
+
+		// Clipped to the image: a rectangle reaching past the edge would put
+		// the text where DrawString's clip silently drops it, and a corner
+		// nobody can see is worse than a corner in the wrong place.
+		r := image.Rect(x, y, x+w, y+h).Intersect(bounds)
+		if r.Empty() {
+			return nil, fmt.Errorf("monitor %q lies outside the image %v", field, bounds)
+		}
+		rects = append(rects, r)
+	}
+
+	if len(rects) == 0 {
+		return nil, fmt.Errorf("WALLPAPER_MONITORS is set but names no geometries")
+	}
+	return rects, nil
+}
