+// parseColor reads an "#RRGGBB" or "#RGB" hex colour, with or without the
+// leading "#", and accepts "white" and "black" for the two this has always
+// used. Anything unparseable is an error rather than a silent fallback: a
+// temperature drawn in a colour nobody asked for is the bug this exists to
+// fix, and doing it quietly would just move it.
+func parseColor(spec string) (color.Color, error) {
+	switch strings.ToLower(strings.TrimSpace(spec)) {
+	case "white":
+		return color.White, nil
+	case "black":
+		return color.Black, nil
+	}
+
+	hex := strings.TrimPrefix(strings.TrimSpace(spec), "#")
+	if len(hex) == 3 {
+		// "#f0a" is "#ff00aa": each digit stands for both nibbles.
+		hex = string([]byte{hex[0], hex[0], hex[1], hex[1], hex[2], hex[2]})
+	}
+	if len(hex) != 6 {
+		return nil, fmt.Errorf("cannot parse colour %q: want #RRGGBB, #RGB, white or black", spec)
+	}
+
+	v, err := strconv.ParseUint(hex, 16, 32)
+	if err != nil {
+		return nil, fmt.Errorf("cannot parse colour %q: %v", spec, err)
+	}
+	return color.RGBA{R: uint8(v >> 16), G: uint8(v >> 8), B: uint8(v), A: 0xff}, nil
+}
+
+// textColors resolves the colour the temperature is drawn in and the colour of
+// the shadow behind it. The defaults are what this drew before they were
+// configurable, so an unset environment is unchanged.
+//
+// They need to be configurable because the legible pair depends on the base
+// image: white-on-black carries a dark sky and vanishes against a pale one,
+// and wallpapers/ holds both. Nothing here knows what the image looks like, so
+// the choice belongs to whoever picked it.
+func textColors() (fg, shadow color.Color, err error) {
+	fg, err = parseColor(envOr("WALLPAPER_TEXT_COLOR", "white"))
+	if err != nil {
+		return nil, nil, err
+	}
+	shadow, err = parseColor(envOr("WALLPAPER_SHADOW_COLOR", "black"))
+	if err != nil {
+		return nil, nil, err
+	}
+	return fg, shadow, nil
+}
